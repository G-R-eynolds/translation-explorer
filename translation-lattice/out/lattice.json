{
 "source": {
  "title": "Er giorno der giudizzio",
  "author": "Giuseppe Gioachino Belli",
  "date": "25 novembre 1831",
  "language": "Romanesco",
  "note": "Text reconstructed; lines 1-6 checked against a web edition, lines 7-14 should be checked against a print edition (e.g. Vigolo).",
  "lines": [
   "Cuattro angioloni co le tromme in bocca",
   "se metteranno uno pe ccantone",
   "a ssonà: poi co ttanto de voscione",
   "cominceranno a ddì: ffora a cchi ttoca.",
   "Allora vierà ssù una filastrocca",
   "de schertri da la terra a ppecorone,",
   "pe rripijjà ffigura de perzone,",
   "come purcini attorno de la bbiocca.",
   "E sta bbiocca sarà Ddio bbenedetto,",
   "che ne farà du' parte, bbianca, e nnera:",
   "una pe annà in cantina, una sur tetto.",
   "All'urtimo usscirà 'na sonajjera",
   "d'angioli, e, ccome si ss'annassi a lletto,",
   "smorzeranno li lumi, e bbona sera."
  ]
 },
 "stances": {
  "literal": "Close, line-for-line English; no rhyme",
  "rhymed": "Formal English verse, attempting rhyme",
  "scots": "Lowland Scots vernacular",
  "london": "Contemporary London vernacular"
 },
 "sampler": "Claude Opus 5.5 (in-session; Anthropic API not reachable from this workspace). Prompted for line-for-line translations under four stances, three samples each.",
 "clusterer": "Claude Opus 5.5 acting as meaning-equivalence judge (same role an API call plays in pipeline.py). Variants that differ only in wording share a cluster.",
 "notes": {
  "0": "'Angioloni' is the augmentative of angelo: it adds size, but also an affectionate, comic deflation of the Apocalypse. Dignified versions lose that irreverence.",
  "1": "'Cantone' is an everyday word for a street corner. Is the Last Judgement staged at the 'four corners of the earth' or on a Roman street?",
  "2": "",
  "3": "'Fora a chi tocca' is a call from games and queues: 'out with whoever's turn it is'. This register choice decides whether the Judgement is a turn-taking game, a waiting room, or Scripture.",
  "4": "'Filastrocca' means a nursery or counting rhyme, and by extension a long string of things. Keeping both senses at once is the hard part.",
  "5": "'A pecorone' comes from pecora, 'sheep', and carries an earthy, even crude posture. Almost every sample flattens it to 'on all fours'.",
  "6": "",
  "7": "",
  "8": "'Dio benedetto' is both a reverent title and an everyday exclamation ('God bless him!'). The sonnet's irreverence turns on the two senses together.",
  "9": "",
  "10": "Belli's speaker maps hell and heaven onto a Roman house: cellar and roof. Almost all samples keep the domestic joke; one abstracts it away.",
  "11": "A 'sonagliera' is a harness of bells for a horse: the angels as a jingling carriage team. Most samples keep the sound but lose the object.",
  "12": "",
  "13": "'E bbona sera' is both 'good night' and 'and that's the end of it'. The universe ends with a shrug. This is the biggest interpretive fork in the poem."
 },
